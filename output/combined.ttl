@prefix cu: <https://example.org/cyrus-unspoken/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cu:affectedEntity a owl:DatatypeProperty ;
    rdfs:domain cu:TacitImplication ;
    rdfs:range xsd:string .

cu:depiction_E01 a cu:Depiction ;
    cu:derivedBy cu:RuleConquest ;
    cu:hasEvidence cu:excerpt_E01 ;
    cu:hasSubject cu:Cyrus ;
    cu:portraysAs cu:Conqueror ;
    cu:triggeredBy cu:action_E01 .

cu:depiction_E02 a cu:Depiction ;
    cu:derivedBy cu:RuleGovernance ;
    cu:hasEvidence cu:excerpt_E02 ;
    cu:hasSubject cu:Cyrus ;
    cu:portraysAs cu:IdealRuler ;
    cu:triggeredBy cu:action_E02 .

cu:depiction_E03 a cu:Depiction ;
    cu:derivedBy cu:RuleRestoration ;
    cu:hasEvidence cu:excerpt_E03 ;
    cu:hasSubject cu:Cyrus ;
    cu:portraysAs cu:Restorer ;
    cu:triggeredBy cu:action_E03 .

cu:depiction_E04 a cu:Depiction ;
    cu:derivedBy cu:RuleRestoration ;
    cu:hasEvidence cu:excerpt_E04 ;
    cu:hasSubject cu:Cyrus ;
    cu:portraysAs cu:Restorer ;
    cu:triggeredBy cu:action_E04 .

