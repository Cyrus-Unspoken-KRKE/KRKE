cu:excerpt_E02 cu:hasImplication cu:implication_E02_PriorCondition .

cu:excerpt_E05 cu:hasImplication cu:implication_E05_PoliticalImpact .

cu:excerpt_E06 cu:hasImplication cu:implication_E06_HumanImpact .

cu:implication_E02_PriorCondition a cu:TacitImplication ;
    cu:affectedEntity "Babylonian citizens" ;
    cu:implicationDerivedBy cu:RulePriorService ;
    cu:implicationKind cu:PriorCondition ;
    cu:implicationText "The passage presupposes an earlier burden of forced service." ;
    cu:implicationTriggeredBy cu:action_E02 .

cu:implication_E05_PoliticalImpact a cu:TacitImplication ;
    cu:affectedEntity "Sardis" ;
    cu:implicationDerivedBy cu:RuleCityCapture ;
    cu:implicationKind cu:PoliticalImpact ;
    cu:implicationText "The city's capture suggests a change of political control in this narrative." ;
    cu:implicationTriggeredBy cu:action_E05 .

cu:implication_E06_HumanImpact a cu:TacitImplication ;
    cu:affectedEntity "Croesus" ;
    cu:implicationDerivedBy cu:RuleCaptivity ;
    cu:implicationKind cu:HumanImpact ;
    cu:implicationText "Captivity implies a restriction of Croesus's personal freedom." ;
    cu:implicationTriggeredBy cu:action_E06 .

