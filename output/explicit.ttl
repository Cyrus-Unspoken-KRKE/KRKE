cu:historical_context_E01 a cu:HistoricalContext ;
    cu:narratedPeriod "539 BCE Babylon campaign" ;
    cu:socialSetting "Babylonian royal rule and conquest; a peaceful entry is the inscription's own presentation" .

cu:historical_context_E02 a cu:HistoricalContext ;
    cu:narratedPeriod "around 539 BCE after the Babylon campaign" ;
    cu:socialSetting "Royal authority and imposed labor in Babylon as narrated by the inscription" .

cu:historical_context_E03 a cu:HistoricalContext ;
    cu:narratedPeriod "around 539 BCE after the Babylon campaign" ;
    cu:socialSetting "Temple cults and the placement of divine images matter in this inscription" .

cu:historical_context_E04 a cu:HistoricalContext ;
    cu:narratedPeriod "late sixth century BCE Babylon setting" ;
    cu:socialSetting "Royal building works and the city wall/quay setting in the inscription" .

cu:historical_context_E05 a cu:HistoricalContext ;
    cu:narratedPeriod "mid sixth century BCE Lydia campaign" ;
    cu:socialSetting "Siege warfare and changing control of a royal city in Herodotus's narrative" .

cu:historical_context_E06 a cu:HistoricalContext ;
    cu:narratedPeriod "mid sixth century BCE Lydia campaign" ;
    cu:socialSetting "War and captivity of a defeated ruler in Herodotus's narrative" .

cu:historical_context_E07 a cu:HistoricalContext ;
    cu:narratedPeriod "mid sixth century BCE Lydia campaign" ;
    cu:socialSetting "The reported pyre precedes the act of mercy; interpret the episode as a whole" .

cu:historical_context_E08 a cu:HistoricalContext ;
    cu:narratedPeriod "539 BCE Babylon campaign" ;
    cu:socialSetting "Military tactics and the entry into a defended city in Herodotus's narrative" .

cu:historical_context_E09 a cu:HistoricalContext ;
    cu:narratedPeriod "sixth century BCE literary setting" ;
    cu:socialSetting "Greek later account of Persian courtly friendship and leadership" .

cu:historical_context_E10 a cu:HistoricalContext ;
    cu:narratedPeriod "sixth century BCE literary setting" ;
    cu:socialSetting "Reward and reciprocal loyalty in Xenophon's idealized Persian court" .

cu:historical_context_E11 a cu:HistoricalContext ;
    cu:narratedPeriod "sixth century BCE literary setting" ;
    cu:socialSetting "Care for companions as a literary quality of leadership" .

cu:historical_context_E12 a cu:HistoricalContext ;
    cu:narratedPeriod "sixth century BCE literary setting" ;
    cu:socialSetting "Military training and rewards within a literary portrait of leadership" .

cu:historical_context_E13 a cu:HistoricalContext ;
    cu:narratedPeriod "late sixth century BCE Babylon setting" ;
    cu:socialSetting "Royal lineage and titulary legitimating the new ruler in the inscription" .

cu:historical_context_E14 a cu:HistoricalContext ;
    cu:narratedPeriod "mid sixth century BCE campaign toward Babylon" ;
    cu:socialSetting "Herodotus's episode about the Gyndes; no target action category" .

cu:narrator_context_cylinder a cu:NarratorContext ;
    dcterms:source <https://www.britishmuseum.org/collection/object/W_1880-0617-1941> ;
    cu:narratorExpectations "Legitimate kingship is conveyed through restoration of cults and relief of burdens; this is a reading of the inscription rather than a survey of all Babylonian views" ;
    cu:narratorPeriod "late sixth century BCE" ;
    cu:narratorViewpoint "Official Babylonian royal inscription associated with Cyrus's takeover" .

cu:narrator_context_cyropaedia a cu:NarratorContext ;
    dcterms:source <https://www.metmuseum.org/it/perspectives/cyrus-the-great> ;
    cu:narratorExpectations "Generosity and care serve a literary argument about leadership; treat these episodes as Xenophon's presentation rather than verified eyewitness reports" ;
    cu:narratorPeriod "fourth century BCE" ;
    cu:narratorViewpoint "Later Greek literary portrayal of Cyrus as an exemplary leader" .

cu:narrator_context_histories a cu:NarratorContext ;
    dcterms:source <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1b*.html> ;
    cu:narratorExpectations "The Croesus story stages reversals of fortune and royal judgment; the pyre episode complicates a simple mercy label" ;
    cu:narratorPeriod "fifth century BCE" ;
    cu:narratorViewpoint "Later Greek historian narrating Cyrus and Croesus" .

