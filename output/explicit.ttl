@prefix cu: <https://example.org/cyrus-unspoken/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

cu:excerpt_E01 a cu:Excerpt ;
    dcterms:source <https://www.livius.org/sources/content/cyrus-cylinder/cyrus-cylinder-translation/> ;
    cu:depictsAction cu:action_E01 ;
    cu:fromSource cu:source_cylinder ;
    cu:hasHistoricalContext cu:historical_context_E01 ;
    cu:paraphrase "Cyrus's army entered Babylon without frightening its inhabitants." ;
    cu:sourceLocator "line 24" .

cu:excerpt_E02 a cu:Excerpt ;
    dcterms:source <https://www.livius.org/sources/content/cyrus-cylinder/cyrus-cylinder-translation/> ;
    cu:depictsAction cu:action_E02 ;
    cu:fromSource cu:source_cylinder ;
    cu:hasHistoricalContext cu:historical_context_E02 ;
    cu:paraphrase "Cyrus freed Babylonian citizens from forced service." ;
    cu:sourceLocator "lines 25-26" .

cu:excerpt_E03 a cu:Excerpt ;
    dcterms:source <https://www.livius.org/sources/content/cyrus-cylinder/cyrus-cylinder-translation/> ;
    cu:depictsAction cu:action_E03 ;
    cu:fromSource cu:source_cylinder ;
    cu:hasHistoricalContext cu:historical_context_E03 ;
    cu:paraphrase "Cyrus returned divine images to their sanctuaries." ;
    cu:sourceLocator "line 32" .

cu:excerpt_E04 a cu:Excerpt ;
    dcterms:source <https://www.livius.org/sources/content/cyrus-cylinder/cyrus-cylinder-translation/> ;
    cu:depictsAction cu:action_E04 ;
    cu:fromSource cu:source_cylinder ;
    cu:hasHistoricalContext cu:historical_context_E04 ;
    cu:paraphrase "Cyrus rebuilt part of Babylon's quay wall." ;
    cu:sourceLocator "lines 39-41" .

cu:excerpt_E05 a cu:Excerpt ;
    dcterms:source <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1b*.html> ;
    cu:depictsAction cu:action_E05 ;
    cu:fromSource cu:source_histories ;
    cu:hasHistoricalContext cu:historical_context_E05 ;
    cu:paraphrase "Cyrus's forces captured Sardis after soldiers breached its wall." ;
    cu:sourceLocator "1.84" .

cu:excerpt_E06 a cu:Excerpt ;
    dcterms:source <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1b*.html> ;
    cu:depictsAction cu:action_E06 ;
    cu:fromSource cu:source_histories ;
    cu:hasHistoricalContext cu:historical_context_E06 ;
    cu:paraphrase "Cyrus's forces took Croesus captive after the fall of Sardis." ;
    cu:sourceLocator "1.86" .

cu:excerpt_E07 a cu:Excerpt ;
    dcterms:source <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1b*.html> ;
    cu:depictsAction cu:action_E07 ;
    cu:fromSource cu:source_histories ;
    cu:hasHistoricalContext cu:historical_context_E07 ;
    cu:paraphrase "Cyrus ordered the pyre extinguished and spared Croesus." ;
    cu:sourceLocator "1.86-88" .

cu:excerpt_E08 a cu:Excerpt ;
    dcterms:source <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1d*.html> ;
    cu:depictsAction cu:action_E08 ;
    cu:fromSource cu:source_histories ;
    cu:hasHistoricalContext cu:historical_context_E08 ;
    cu:paraphrase "Cyrus diverted the Euphrates so his soldiers entered Babylon." ;
    cu:sourceLocator "1.191" .

cu:excerpt_E09 a cu:Excerpt ;
    dcterms:source <https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A1999.01.0204%3Abook%3D8%3Achapter%3D2> ;
    cu:depictsAction cu:action_E09 ;
    cu:fromSource cu:source_cyropaedia ;
    cu:hasHistoricalContext cu:historical_context_E09 ;
    cu:paraphrase "Cyrus supported companions during their misfortunes." ;
    cu:sourceLocator "8.2.1-2" .

cu:excerpt_E10 a cu:Excerpt ;
    dcterms:source <https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A1999.01.0204%3Abook%3D8%3Achapter%3D2> ;
    cu:depictsAction cu:action_E10 ;
    cu:fromSource cu:source_cyropaedia ;
    cu:hasHistoricalContext cu:historical_context_E10 ;
    cu:paraphrase "Cyrus rewarded those whose service pleased him." ;
    cu:sourceLocator "8.2.3" .

cu:excerpt_E11 a cu:Excerpt ;
    dcterms:source <https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A1999.01.0204%3Abook%3D8%3Achapter%3D2> ;
    cu:depictsAction cu:action_E11 ;
    cu:fromSource cu:source_cyropaedia ;
    cu:hasHistoricalContext cu:historical_context_E11 ;
    cu:paraphrase "Cyrus visited sick companions and provided what they needed." ;
    cu:sourceLocator "8.2.25" .

cu:excerpt_E12 a cu:Excerpt ;
    dcterms:source <https://www.cais-soas.com/CAIS/History/hakhamaneshian/xenophon/cyropaedia/xenophon_book_6.htm> ;
    cu:depictsAction cu:action_E12 ;
    cu:fromSource cu:source_cyropaedia ;
    cu:hasHistoricalContext cu:historical_context_E12 ;
    cu:paraphrase "Cyrus rewarded the most efficient hunters." ;
    cu:sourceLocator "6.2.5" .

cu:excerpt_E13 a cu:Excerpt ;
    dcterms:source <https://www.livius.org/sources/content/cyrus-cylinder/cyrus-cylinder-translation/> ;
    cu:fromSource cu:source_cylinder ;
    cu:hasHistoricalContext cu:historical_context_E13 ;
    cu:paraphrase "Cyrus lists royal titles and his ancestry." ;
    cu:sourceLocator "line 20-22" .

cu:excerpt_E14 a cu:Excerpt ;
    dcterms:source <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1d*.html> ;
    cu:fromSource cu:source_histories ;
    cu:hasHistoricalContext cu:historical_context_E14 ;
    cu:paraphrase "Cyrus's white horse drowned in the river Gyndes." ;
    cu:sourceLocator "1.189" .

