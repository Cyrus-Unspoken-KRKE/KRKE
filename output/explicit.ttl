    dcterms:creator "Xenophon" ;
    dcterms:identifier <https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A1999.01.0204%3Abook%3D8%3Achapter%3D2> ;
    dcterms:title "Cyropaedia" ;
    cu:hasNarratorContext cu:narrator_context_cyropaedia .

cu:source_cylinder a cu:Source ;
    dcterms:creator "Ancient Babylonian royal inscription" ;
    dcterms:identifier <https://www.livius.org/sources/content/cyrus-cylinder/cyrus-cylinder-translation/> ;
    dcterms:title "Cyrus Cylinder" ;
    cu:hasNarratorContext cu:narrator_context_cylinder .

cu:source_histories a cu:Source ;
    dcterms:creator "Herodotus" ;
    dcterms:identifier <https://penelope.uchicago.edu/Thayer/E/Roman/Texts/Herodotus/1b*.html> ;
    dcterms:title "Histories Book I" ;
    cu:hasNarratorContext cu:narrator_context_histories .

